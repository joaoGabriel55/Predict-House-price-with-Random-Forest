<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>House Price Predictor - AI Text Mode</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    textarea {
      width: 100%;
      padding: 12px 14px;
      background: #f8f9fa;
      border: 1px solid #e8e8e8;
      border-radius: 8px;
      font-size: 0.938rem;
      color: #2c3e50;
      transition: all 0.2s ease;
      outline: none;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      resize: vertical;
      min-height: 120px;
      line-height: 1.5;
    }

    textarea:focus {
      border-color: #c9a961;
      background: #ffffff;
      box-shadow: 0 0 0 3px rgba(201, 169, 97, 0.1);
    }

    textarea::placeholder {
      color: #95a5a6;
    }

    .mode-toggle {
      text-align: center;
      margin-bottom: 24px;
      padding: 10px;
      background: #f8f9fa;
      border-radius: 6px;
    }

    .mode-toggle a {
      color: #c9a961;
      text-decoration: none;
      font-size: 0.875rem;
      font-weight: 600;
      transition: all 0.2s ease;
    }

    .mode-toggle a:hover {
      color: #e57a44;
    }
  </style>
</head>
<body>
  <div class="card">
    <h1>AI-Powered Price Estimator</h1>
    <p class="subtitle">Describe your property in natural language</p>

    <div class="mode-toggle">
      <a href="/">← Switch to Manual Input Mode</a>
    </div>

    <% if defined?(error_message) && error_message %>
      <div class="result error">
        <div class="label">Error</div>
        <div class="price"><%= error_message %></div>
      </div>
    <% end %>

    <form action="/llm/predict" method="post">
      <div class="form-group">
        <label>Describe your Las Vegas house</label>
        <textarea
          name="description"
          placeholder="e.g. House built in 2005, 1500 sq ft lot, land value $28,000, improvement value $65,000, in zipcode 891490000"
          required><%= defined?(description) ? description : '' %></textarea>
      </div>

      <button type="submit">Analyze & Predict</button>
    </form>
  </div>
</body>
</html>
