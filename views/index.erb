<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>House Price Predictor</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    .mode-toggle {
      text-align: center;
      margin-bottom: 24px;
      padding: 10px;
      background: #f8f9fa;
      border-radius: 6px;
    }

    .mode-toggle a {
      color: #c9a961;
      text-decoration: none;
      font-size: 0.875rem;
      font-weight: 600;
      transition: all 0.2s ease;
    }

    .mode-toggle a:hover {
      color: #e57a44;
    }
  </style>
</head>
<body>
  <div class="card">
    <h1>Las Vegas House Price Estimator</h1>
    <p class="subtitle">Predict property values using machine learning</p>

    <div class="mode-toggle">
      <a href="/llm">Switch to AI Text Mode →</a>
    </div>

    <% if defined?(error_message) && error_message %>
      <div class="result error">
        <div class="label">Error</div>
        <div class="price"><%= error_message %></div>
      </div>
    <% end %>

    <form action="/predict" method="post">
      <div class="form-group">
        <label>Construction Year</label>
        <input type="number" name="construction_year" placeholder="e.g. 2005" min="1900" max="2026" required>
      </div>

      <div class="form-group">
        <label>Lot Size <span class="unit">(square feet)</span></label>
        <input type="number" name="lot_sqft" placeholder="e.g. 1500" min="1" required>
      </div>

      <div class="form-group">
        <label>Calculated Acres</label>
        <input type="number" name="calc_acres" placeholder="e.g. 0.0" step="0.01" min="0" required>
      </div>

      <div class="form-group">
        <label>Land Value <span class="unit">($)</span></label>
        <input type="number" name="land_value" placeholder="e.g. 28000" min="0" required>
      </div>

      <div class="form-group">
        <label>Improvement Value <span class="unit">($)</span></label>
        <input type="number" name="improvement_value" placeholder="e.g. 65000" min="0" required>
      </div>

      <div class="form-group">
        <label>Zipcode</label>
        <input type="number" name="zipcode" placeholder="e.g. 891290000" min="1" required>
      </div>

      <button type="submit">Calculate Price</button>
    </form>
  </div>
</body>
</html>
