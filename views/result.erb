<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Prediction Result - House Price Predictor</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="card">
    <h1>Las Vegas House Price Estimator</h1>
    <p class="subtitle">Your estimated property value</p>

    <div class="result">
      <div class="label">Predicted Price</div>
      <div class="price">$<%= format('%.2f', price) %></div>
    </div>

    <div class="input-summary">
      <h2>Input Parameters</h2>
      <ul>
        <li><strong>Construction Year:</strong> <%= construction_year %></li>
        <li><strong>Lot Size:</strong> <%= lot_sqft %> sq ft</li>
        <li><strong>Calculated Acres:</strong> <%= calc_acres %></li>
        <li><strong>Land Value:</strong> $<%= format('%.2f', land_value.to_f) %></li>
        <li><strong>Improvement Value:</strong> $<%= format('%.2f', improvement_value.to_f) %></li>
        <li><strong>Zipcode:</strong> <%= zipcode %></li>
      </ul>
    </div>

    <a href="/" class="back-link">← Make another prediction</a>
  </div>
</body>
</html>
